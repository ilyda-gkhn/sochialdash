PORT=3000
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:3000

JWT_SECRET=change-this-to-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
# The refresh token itself is delivered to browsers as an HttpOnly,
# SameSite=Strict cookie scoped to /api/auth (set on login/register/refresh/
# OAuth sign-in) - not just in the JSON response - so it's inaccessible to
# page JavaScript. It's also still returned in the JSON body for non-browser
# API clients. In production (NODE_ENV=production) the cookie additionally
# gets the Secure flag, so the app must be served over HTTPS.
JWT_REFRESH_EXPIRES_DAYS=30

# "Sign in with Google" / "Sign in with Apple" on the login/register screen.
# This is separate from the per-platform OAuth apps below, which are for
# connecting social accounts to publish/read content, not for user login.
# OAuth login routes are implemented; provider credentials are required.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# OAuth callback base used to build each platform's redirect_uri
OAUTH_REDIRECT_BASE=http://localhost:3000
# Public HTTPS origin from which Meta platforms can fetch uploaded media.
# Localhost URLs cannot be used by Instagram/Facebook/Threads.
MEDIA_PUBLIC_BASE_URL=
META_GRAPH_API_VERSION=v23.0
# Use a separate long random secret in production. Existing encrypted tokens
# cannot be read if this value is changed.
SOCIAL_TOKEN_ENCRYPTION_KEY=change-this-to-another-long-random-string

# AI provider (chat replies, hashtag/caption/content-idea tools)
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_MAX_TOKENS=800

# External news provider
NEWS_API_KEY=
NEWS_COUNTRY=us
NEWS_LANGUAGE=en
NEWS_CACHE_SECONDS=300
NEWS_TIMEOUT_MS=12000
NEWS_PAGE_SIZE=50

# Outgoing email (password reset)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=SocialDash <no-reply@example.com>
EMAIL_SECURE=false
EMAIL_TIMEOUT_MS=10000
APP_BASE_URL=http://localhost:3000

# Generate once with: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Social platform OAuth apps
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

X_CLIENT_ID=
X_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_PRIVACY_LEVEL=SELF_ONLY

YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_PRIVACY_STATUS=private
YOUTUBE_CATEGORY_ID=22

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=

# Media/avatar storage backend. Only "local" (disk under uploads/) is
# currently implemented (see services/storageService.js). Setting this to
# anything else (e.g. "s3", "cloudinary") will fail fast at startup with a
# clear error until that backend is actually built.
MEDIA_STORAGE_PROVIDER=local
